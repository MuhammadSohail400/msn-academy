# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/msn_academy

# Redis & BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Authentication & JWT
JWT_SECRET=msn_super_secret_jwt_access_token_key_32chars!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=msn_super_secret_jwt_refresh_token_key_32chars!
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=msn_cookie_signing_secret_key_32chars!

# Security & CORS
CORS_ORIGIN=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email Service (Option 1: Gmail SMTP via Nodemailer — sends to ANY email)
SMTP_USER=msohailg211@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Email Service (Option 2: Resend API)
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=MSN Academy <onboarding@resend.dev>
ADMIN_EMAIL=admissions@msnacademy.pk
